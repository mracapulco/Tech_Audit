# Configuração do docker-compose.yml. Copie para .env e ajuste.

# Senha do banco. Use só letras e números (ela vai dentro de uma URL).
POSTGRES_PASSWORD=troque-esta-senha

# Primeiro administrador do portal, criado na primeira subida se ainda não
# houver nenhum. Depois de entrar, você pode apagar estas duas linhas.
BOOTSTRAP_ADMIN_EMAIL=admin@techmaster.com.br
BOOTSTRAP_ADMIN_PASSWORD=troque-esta-senha-tambem

# Portas publicadas na máquina.
PORTAL_PORT=3000
API_PORT=3001

# Endereço que os agentes usam para chegar na API (aparece no agent.json
# gerado pelo portal). Em produção, o domínio público, ex.:
# https://ingest.audit.techmaster.com.br
PUBLIC_AGENT_URL=http://localhost:3001

# O cookie de login exige HTTPS. Deixe false para testar em http://;
# em produção, atrás de HTTPS, use true.
COOKIE_SECURE=false
