# Configuração do docker-compose.yml. Copie para .env e ajuste.
# O docker-compose.yml é o mesmo na homologação (seu PC) e na produção
# (servidor); só este arquivo muda. Os valores de cada ambiente estão
# em docs/DEPLOY.md.

# Senha do banco. Use só letras e números (ela vai dentro de uma URL).
POSTGRES_PASSWORD=troque-esta-senha

# Primeiro administrador do portal, criado na primeira subida se ainda não
# houver nenhum. Depois de entrar, você pode apagar estas duas linhas.
BOOTSTRAP_ADMIN_EMAIL=rafael@techmaster.inf.br
BOOTSTRAP_ADMIN_PASSWORD=troque-esta-senha-tambem

# Portas publicadas na máquina. O banco só aceita conexões da própria máquina.
PORTAL_PORT=3000
API_PORT=3001
DB_PORT=5432

# Em que endereço da máquina o portal e a API escutam. 0.0.0.0 = todos (outras
# máquinas da rede alcançam). Com o HAProxy em outra VM, deixe 0.0.0.0 e
# libere as portas só para o IP dele no firewall. Com o proxy HTTPS rodando na
# própria máquina, use 127.0.0.1.
BIND_ADDRESS=0.0.0.0

# Endereço que os agentes usam para chegar na API (aparece no agent.json
# gerado pelo portal). Em produção, o domínio público, ex.:
# https://ingest.audit.techmaster.inf.br
PUBLIC_AGENT_URL=http://localhost:3001

# O cookie de login exige HTTPS. Deixe false para testar em http://;
# em produção, atrás de HTTPS, use true.
COOKIE_SECURE=false
