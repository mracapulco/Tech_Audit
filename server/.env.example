DATABASE_URL="postgresql://techaudit:techaudit@localhost:5432/techaudit?schema=public"
PORT=3001
# Proxies cujo X-Forwarded-For é aceito (o portal Next.js e o Traefik).
# TRUST_PROXY="loopback, linklocal, uniquelocal"
# Máximo de linhas na exportação CSV síncrona do portal.
# EXPORT_MAX_ROWS=100000
# E-mail dos alertas e relatórios agendados. Sem SMTP_HOST, nada é enviado.
# SMTP_HOST=smtp.exemplo.com.br
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM="Tech Audit <nao-responda@techmaster.inf.br>"
# PORTAL_URL=https://audit.techmaster.inf.br
# Intervalo do laço de alertas e envios, em ms (0 desliga; os testes usam 0).
# NOTIFY_INTERVAL_MS=60000
