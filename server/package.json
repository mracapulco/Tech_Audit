{
  "name": "@tech-audit/server",
  "version": "0.1.0",
  "private": true,
  "description": "Tech Audit central server (API + ingestão dos agentes)",
  "scripts": {
    "build": "nest build",
    "start": "node --env-file-if-exists=.env dist/main.js",
    "start:dev": "nest start --watch",
    "cli": "node --env-file-if-exists=.env dist/cli.js",
    "db:migrate": "prisma migrate deploy && node --env-file-if-exists=.env dist/cli.js migrate-events",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "test": "rm -rf dist-test && tsc -p tsconfig.test.json && MFA_REQUIRED_ROLES=none NOTIFY_INTERVAL_MS=0 node --env-file-if-exists=.env --test --test-concurrency=1 'dist-test/test/**/*.test.js'",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "@nestjs/common": "^12.1.2",
    "@nestjs/core": "^12.1.2",
    "@nestjs/platform-express": "^12.1.2",
    "@node-rs/argon2": "^2.2.1",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "dotenv": "^18.0.5",
    "nodemailer": "^10.0.14",
    "pdfkit": "^0.20.2",
    "pg": "^8.23.1",
    "prisma": "^7.10.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.8",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.4",
    "@types/nodemailer": "^8.0.2",
    "@types/pdfkit": "^0.17.6",
    "@types/pg": "^8.23.1",
    "typescript": "^6.0.3"
  },
  "type": "module",
  "engines": {
    "node": ">=22.12"
  }
}
