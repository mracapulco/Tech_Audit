// Modelo relacional do Tech Audit (docs/ARCHITECTURE.md, seção 6.3).
// Os eventos de arquivo ficam fora do Prisma: tabela events.file_events
// (hypertable do TimescaleDB), criada por src/db/events-migrations.ts.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
  moduleFormat = "esm"
  // Fixo: sem o tsconfig.json por perto (ex.: no build do Docker) o Prisma
  // gera imports ".ts", que o Node não resolve depois de compilado.
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

// Empresa cliente da Tech Master.
model Tenant {
  id               String            @id @default(uuid()) @db.Uuid
  name             String
  createdAt        DateTime          @default(now()) @map("created_at")
  agents           Agent[]
  licenses         License[]
  enrollmentTokens EnrollmentToken[]
  users            User[]
  auditedPaths     AuditedPath[]
  // Faixa do volume auditado já avisada (0, 80 ou 100%), para alertar só na subida.
  volumeAlertLevel Int               @default(0) @map("volume_alert_level")

  @@map("tenants")
}

// Licença do tenant (seção 9.2). Um tenant pode ter várias; os limites das
// licenças vigentes são somados.
model License {
  id             String              @id @default(uuid()) @db.Uuid
  tenantId       String              @map("tenant_id") @db.Uuid
  tenant         Tenant              @relation(fields: [tenantId], references: [id])
  plan           String
  maxAgents      Int                 @map("max_agents")
  // Soma do tamanho dos diretórios auditados, em bytes.
  maxVolumeBytes BigInt              @map("max_volume_bytes")
  retentionDays  Int                 @map("retention_days")
  validFrom      DateTime            @map("valid_from")
  // Instante em que a licença vence; a ingestão segue aceita por graceDays.
  validUntil     DateTime            @map("valid_until")
  graceDays      Int                 @default(1) @map("grace_days")
  revokedAt      DateTime?           @map("revoked_at")
  createdAt      DateTime            @default(now()) @map("created_at")
  activations    LicenseActivation[]

  @@index([tenantId])
  @@map("licenses")
}

// Token de registro gerado no portal (seção 5). Só o hash é guardado.
model EnrollmentToken {
  id          String    @id @default(uuid()) @db.Uuid
  tenantId    String    @map("tenant_id") @db.Uuid
  tenant      Tenant    @relation(fields: [tenantId], references: [id])
  tokenHash   String    @unique @map("token_hash")
  description String?
  expiresAt   DateTime  @map("expires_at")
  maxUses     Int       @map("max_uses")
  uses        Int       @default(0)
  revokedAt   DateTime? @map("revoked_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  @@map("enrollment_tokens")
}

// Agente instalado em um servidor de arquivos do cliente. Cada agente ativo
// (disabledAt nulo) ocupa uma vaga da licença.
model Agent {
  id           String              @id @default(uuid()) @db.Uuid
  tenantId     String              @map("tenant_id") @db.Uuid
  tenant       Tenant              @relation(fields: [tenantId], references: [id])
  hostname     String
  os           String
  // Hash estável da máquina enviado pelo agente; reinstalar reaproveita a vaga.
  machineId    String              @map("machine_id")
  agentVersion String?             @map("agent_version")
  // Hash SHA-256 do token Bearer de longa duração (protótipo, antes do mTLS).
  tokenHash    String              @unique @map("token_hash")
  lastSeenAt   DateTime?           @map("last_seen_at")
  // Último sinal de vida do agente (POST /v1/heartbeat, a cada minuto mesmo sem eventos).
  lastHeartbeatAt DateTime?        @map("last_heartbeat_at")
  // Eventos e bytes aguardando envio no buffer local, informados no heartbeat.
  bufferEvents Int?                @map("buffer_events")
  bufferBytes  BigInt?             @map("buffer_bytes")
  disabledAt   DateTime?           @map("disabled_at")
  createdAt    DateTime            @default(now()) @map("created_at")
  activations  LicenseActivation[]
  auditedPaths AuditedPath[]
  // Versão da configuração de auditoria; sobe a cada alteração no portal.
  configVersion        Int       @default(0) @map("config_version")
  // Última versão que o agente informou ter aplicado.
  configAppliedVersion Int?      @map("config_applied_version")
  configFetchedAt      DateTime? @map("config_fetched_at")
  sizesMeasuredAt      DateTime? @map("sizes_measured_at")

  @@unique([tenantId, machineId])
  @@map("agents")
}

// Histórico de registros de agentes contra uma licença.
model LicenseActivation {
  id        String   @id @default(uuid()) @db.Uuid
  licenseId String   @map("license_id") @db.Uuid
  license   License  @relation(fields: [licenseId], references: [id])
  agentId   String   @map("agent_id") @db.Uuid
  agent     Agent    @relation(fields: [agentId], references: [id])
  hostname  String
  machineId String   @map("machine_id")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([agentId])
  @@map("license_activations")
}

// Lotes recebidos. Garante idempotência por (agent_id, batch_id) e guarda o
// hash do conteúdo para provar integridade (seção 8).
model IngestBatch {
  agentId       String   @map("agent_id") @db.Uuid
  batchId       String   @map("batch_id") @db.Uuid
  tenantId      String   @map("tenant_id") @db.Uuid
  eventCount    Int      @map("event_count")
  insertedCount Int      @map("inserted_count")
  rejectedCount Int      @map("rejected_count")
  sha256        String
  receivedAt    DateTime @default(now()) @map("received_at")

  @@id([agentId, batchId])
  @@map("ingest_batches")
}

// Dicionário de caminhos, para não repetir strings longas em cada evento.
// pathHash = SHA-256 do caminho em minúsculas (NTFS não diferencia caixa).
model Path {
  id       BigInt @id @default(autoincrement())
  tenantId String @map("tenant_id") @db.Uuid
  agentId  String @map("agent_id") @db.Uuid
  pathHash Bytes  @map("path_hash")
  path     String

  @@unique([agentId, pathHash])
  @@index([tenantId])
  @@map("paths")
}

// Dicionário de identidades por tenant. key = SID ou DOMINIO\usuario em minúsculas.
model Identity {
  id       BigInt  @id @default(autoincrement())
  tenantId String  @map("tenant_id") @db.Uuid
  key      String
  sid      String?
  domain   String
  name     String

  @@unique([tenantId, key])
  @@map("identities")
}

// Usuário do portal (seção 6.2). tenantId nulo = equipe Tech Master
// (msp_admin/msp_operator), com acesso a todos os tenants.
model User {
  id           String        @id @default(uuid()) @db.Uuid
  tenantId     String?       @map("tenant_id") @db.Uuid
  tenant       Tenant?       @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  // Sempre em minúsculas.
  email        String        @unique
  name         String
  // msp_admin, msp_operator, tenant_admin, tenant_auditor
  role         String
  // Argon2id.
  passwordHash String        @map("password_hash")
  lastLoginAt  DateTime?     @map("last_login_at")
  disabledAt   DateTime?     @map("disabled_at")
  createdAt    DateTime      @default(now()) @map("created_at")
  // Verificação em duas etapas (TOTP, Google Authenticator). totpSecret em
  // base32; totpLastStep é o último código aceito, que não vale de novo.
  totpSecret        String?   @map("totp_secret")
  totpEnabledAt     DateTime? @map("totp_enabled_at")
  totpLastStep      BigInt?   @map("totp_last_step")
  // Segredo gerado em "Minha conta", até o usuário confirmar o primeiro código.
  totpPendingSecret String?   @map("totp_pending_secret")
  sessions     UserSession[]
  challenges   LoginChallenge[]

  @@index([tenantId])
  @@map("users")
}

// Login com senha certa aguardando o código do autenticador (kind "verify")
// ou o cadastro do autenticador, obrigatório para o perfil (kind "setup").
model LoginChallenge {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique @map("token_hash")
  kind      String
  // Segredo novo, no cadastro.
  secret    String?
  attempts  Int       @default(0)
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([userId])
  @@map("login_challenges")
}

// Sessão do portal: token opaco, só o hash fica no banco. Sair ou desativar o
// usuário invalida na hora (diferente de um JWT).
model UserSession {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  user       User      @relation(fields: [userId], references: [id])
  tokenHash  String    @unique @map("token_hash")
  expiresAt  DateTime  @map("expires_at")
  ip         String?
  userAgent  String?   @map("user_agent")
  revokedAt  DateTime? @map("revoked_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  @@index([userId])
  @@map("user_sessions")
}

// Quem consultou ou exportou o quê no portal (seção 8). Somente inserção.
model PortalAuditLog {
  id        BigInt   @id @default(autoincrement())
  userId    String?  @map("user_id") @db.Uuid
  tenantId  String?  @map("tenant_id") @db.Uuid
  // login, login_failed, logout, events.search, events.export, agent.download
  action    String
  details   Json?
  ip        String?
  createdAt DateTime @default(now()) @map("created_at")

  @@index([tenantId, createdAt])
  @@map("portal_audit_log")
}

// Caminho auditado em um servidor (seção 4.6). O portal grava o desejado
// (desiredState, opções); o agente aplica a SACL e devolve o status.
// Remover não apaga a linha: fica "removed" depois que o agente confirma.
model AuditedPath {
  id           String    @id @default(uuid()) @db.Uuid
  tenantId     String    @map("tenant_id") @db.Uuid
  tenant       Tenant    @relation(fields: [tenantId], references: [id])
  agentId      String    @map("agent_id") @db.Uuid
  agent        Agent     @relation(fields: [agentId], references: [id])
  path         String
  // Caminho normalizado (minúsculas, sem barra final): o NTFS não diferencia caixa.
  pathKey      String    @map("path_key")
  // Herança da SACL para subpastas e arquivos.
  recursive    Boolean   @default(true)
  // Leitura gera muito volume: desligada por padrão.
  auditRead    Boolean   @default(false) @map("audit_read")
  // Padrões ignorados pelo agente na coleta (ex.: *.tmp, ~$*).
  exclusions   String[]  @default([])
  // active ou removed (o que o portal pediu).
  desiredState String    @default("active") @map("desired_state")
  // pending, applied, error, divergent, removing, removed (o que o agente informou).
  status       String    @default("pending")
  lastError    String?   @map("last_error")
  appliedAt    DateTime? @map("applied_at")
  // Tamanho medido pelo agente (arquivos e subpastas, recursivo), em bytes.
  sizeBytes    BigInt?   @map("size_bytes")
  sizeError    String?   @map("size_error")
  sizeMeasuredAt DateTime? @map("size_measured_at")
  createdById  String?   @map("created_by_id") @db.Uuid
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  @@unique([agentId, pathKey])
  @@index([tenantId])
  @@map("audited_paths")
}

// Log imutável de alterações da auditoria (seção 4.6): pedidos feitos no
// portal e resultados aplicados pelo agente, com SACL e política antes e
// depois. Um gatilho no banco recusa UPDATE e DELETE.
model AuditConfigChange {
  id            BigInt   @id @default(autoincrement())
  tenantId      String   @map("tenant_id") @db.Uuid
  agentId       String   @map("agent_id") @db.Uuid
  auditedPathId String?  @map("audited_path_id") @db.Uuid
  path          String
  // Pedidos: add, update, remove, reapply. Agente: applied, removed, error, divergent.
  kind          String
  // portal ou agent.
  source        String
  configVersion Int      @map("config_version")
  // Quem pediu (cópias, para o histórico sobreviver à exclusão do usuário).
  userId        String?  @map("user_id") @db.Uuid
  userEmail     String?  @map("user_email")
  userRole      String?  @map("user_role")
  ip            String?
  details       Json?
  message       String?
  createdAt     DateTime @default(now()) @map("created_at")

  @@index([tenantId, createdAt])
  @@index([agentId, createdAt])
  @@map("audit_config_changes")
}

// Alertas para o portal (dashboard e configuração). Por enquanto: alterações
// de auditoria aplicadas, erros, divergências e volume da licença.
model Alert {
  id             BigInt    @id @default(autoincrement())
  tenantId       String    @map("tenant_id") @db.Uuid
  agentId        String?   @map("agent_id") @db.Uuid
  // audit_config_changed, audit_config_error, audit_config_divergent, volume_80, volume_100
  kind           String
  // info, warning, critical
  severity       String
  message        String
  details        Json?
  acknowledgedAt DateTime? @map("acknowledged_at")
  acknowledgedBy String?   @map("acknowledged_by") @db.Uuid
  createdAt      DateTime  @default(now()) @map("created_at")

  @@index([tenantId, createdAt])
  @@map("alerts")
}
